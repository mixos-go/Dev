<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_messages_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Welcome State (shown when no messages) -->
    <LinearLayout
        android:id="@+id/welcome_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_xl"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- AI Avatar -->
        <ImageView
            android:id="@+id/ai_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_ai_avatar"
            android:contentDescription="@string/nav_home" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/ai_welcome_title"
            style="@style/TextStyle.H3"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/ai_welcome_subtitle"
            style="@style/TextStyle.Body"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

        <!-- Quick Actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quick_action_terminal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Run command"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_sm"
                android:textColor="@color/accent_mauve"
                android:textSize="@dimen/font_caption" />

            <View android:layout_width="@dimen/space_sm" android:layout_height="1dp" />

            <TextView
                android:id="@+id/quick_action_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create file"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_sm"
                android:textColor="@color/accent_olive"
                android:textSize="@dimen/font_caption" />

            <View android:layout_width="@dimen/space_sm" android:layout_height="1dp" />

            <TextView
                android:id="@+id/quick_action_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search web"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_sm"
                android:textColor="@color/accent_terracotta"
                android:textSize="@dimen/font_caption" />

        </LinearLayout>

    </LinearLayout>

    <!-- Input Container -->
    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm"
        android:layout_marginHorizontal="@dimen/space_md"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_input_container"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:maxLines="5"
            android:hint="@string/ai_input_hint"
            android:textSize="@dimen/font_body"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:background="@android:color/transparent"
            android:inputType="textMultiLine"
            android:imeOptions="actionSend" />

        <FrameLayout
            android:id="@+id/send_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_send_button">
            <ImageView
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                android:tint="@color/white"
                android:contentDescription="@string/ai_send" />
        </FrameLayout>

    </LinearLayout>

    <!-- Typing Indicator -->
    <LinearLayout
        android:id="@+id/typing_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm"
        android:background="@drawable/bg_card"
        android:visibility="gone"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_sm"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/typing_dot_1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_typing_dot" />
        <View
            android:id="@+id/typing_dot_2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_typing_dot" />
        <View
            android:id="@+id/typing_dot_3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_typing_dot" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
