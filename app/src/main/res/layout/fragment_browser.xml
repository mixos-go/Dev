<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browser_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <!-- URL Bar Container -->
    <LinearLayout
        android:id="@+id/url_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm"
        android:background="@color/bg_surface"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_secondary"
            android:background="@drawable/bg_nav_item"
            android:contentDescription="@string/browser_back" />

        <!-- Forward Button -->
        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_forward"
            android:tint="@color/text_secondary"
            android:background="@drawable/bg_nav_item"
            android:contentDescription="@string/browser_forward" />

        <!-- URL Input -->
        <EditText
            android:id="@+id/url_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_sm"
            android:hint="@string/browser_url_hint"
            android:textSize="@dimen/font_body"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/bg_url_input"
            android:paddingHorizontal="@dimen/space_md"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/text_secondary"
            android:background="@drawable/bg_nav_item"
            android:contentDescription="@string/browser_refresh" />

        <!-- Tabs Button -->
        <FrameLayout
            android:id="@+id/btn_tabs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_nav_item">
            <TextView
                android:id="@+id/tab_count"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:text="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_tab_count" />
        </FrameLayout>

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/loading_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:progressTint="@color/accent_mauve"
        android:progressBackgroundTint="@color/bg_soft"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/url_bar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- WebView Container with ViewPager2 for tabs -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/loading_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:background="@color/bg_canvas">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_browser"
                android:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="Enter a URL to browse"
                style="@style/TextStyle.Body"
                android:textColor="@color/text_secondary" />

            <!-- Quick Links -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quick_localhost_3000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="localhost:3000"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="@dimen/space_sm"
                    android:textColor="@color/accent_mauve"
                    android:textSize="@dimen/font_caption" />

                <View android:layout_width="@dimen/space_sm" android:layout_height="1dp" />

                <TextView
                    android:id="@+id/quick_localhost_8080"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="localhost:8080"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="@dimen/space_sm"
                    android:textColor="@color/accent_olive"
                    android:textSize="@dimen/font_caption" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Tabs Modal (shown when clicking tab button) -->
    <FrameLayout
        android:id="@+id/tabs_modal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/overlay_dark"
        android:visibility="gone"
        android:elevation="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_modal"
            android:padding="@dimen/space_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tabs"
                style="@style/TextStyle.H3" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tabs_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:maxHeight="300dp" />

            <Button
                android:id="@+id/btn_new_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/browser_new_tab"
                style="@style/ButtonStyle.Primary" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
