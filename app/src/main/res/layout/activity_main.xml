<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <!-- Main ViewPager2 for swipe navigation between Terminal, Home, Browser -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/main_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Bottom Navigation (only visible on Home screen) -->
    <LinearLayout
        android:id="@+id/floating_nav_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/nav_height"
        android:layout_marginBottom="@dimen/nav_margin_bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_lg"
        android:background="@drawable/bg_floating_nav"
        android:elevation="8dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dev Button -->
        <FrameLayout
            android:id="@+id/nav_dev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_nav_item"
            android:foregroundGravity="center">
            <ImageView
                android:id="@+id/nav_dev_icon"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_dev"
                android:tint="@color/nav_icon_inactive"
                android:contentDescription="@string/nav_dev" />
        </FrameLayout>

        <!-- Spacer -->
        <View
            android:layout_width="@dimen/space_lg"
            android:layout_height="1dp" />

        <!-- Home Button (Active) -->
        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_nav_item"
            android:foregroundGravity="center">
            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_home"
                android:tint="@color/nav_icon_active"
                android:contentDescription="@string/nav_home" />
        </FrameLayout>

        <!-- Spacer -->
        <View
            android:layout_width="@dimen/space_lg"
            android:layout_height="1dp" />

        <!-- Workspace Button -->
        <FrameLayout
            android:id="@+id/nav_workspace"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_nav_item"
            android:foregroundGravity="center">
            <ImageView
                android:id="@+id/nav_workspace_icon"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_workspace"
                android:tint="@color/nav_icon_inactive"
                android:contentDescription="@string/nav_workspace" />
        </FrameLayout>

    </LinearLayout>

    <!-- Settings Button (Top Right) -->
    <FrameLayout
        android:id="@+id/settings_fab"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_md"
        android:background="@drawable/bg_settings_button"
        android:elevation="4dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:layout_gravity="center"
            android:src="@drawable/ic_settings_gear"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/action_open_settings" />
    </FrameLayout>

    <!-- Modal Container for Dev, Workspace, Settings -->
    <FrameLayout
        android:id="@+id/modal_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:elevation="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
